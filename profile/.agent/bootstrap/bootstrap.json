    {
      "capability": "simplicity",
      "owner": "skills",
      "path": "skills/simplicity/SKILL.md"
    },
    {
      "capability": "github_workflow",
      "owner": "skills",
      "path": "skills/github-workflow/SKILL.md"
    },
    {
      "capability": "verification",
      "owner": "skills",
      "path": "skills/verification/SKILL.md"
    },
    {
      "capability": "engineering_assurance",
