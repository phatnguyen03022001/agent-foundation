      "capability": "local_execution_transport",
      "owner": "agent-runtime",
      "path": "README.md"
    }
  ],
  "execution_surfaces": [
    {
      "id": "CHATGPT_GITHUB",
      "controller": "CHATGPT",
      "location": "GITHUB",
      "transport": "GITHUB",
      "model": "GPT-5.6 Sol",
      "effort": "HIGH"
    },
    {
      "id": "CHATGPT_LOCAL",
      "controller": "CHATGPT",
      "location": "LOCAL",
      "transport": "AGENT_RUNTIME",
      "model": "GPT-5.6 Sol",
      "effort": "HIGH"
    },
    {
      "id": "CODEX_CLOUD",
      "controller": "CODEX",
      "location": "CLOUD",
      "transport": "NATIVE",
      "model": "LUNA",
      "effort": "MEDIUM"
    },
    {
      "id": "CODEX_LOCAL",
      "controller": "CODEX",
      "location": "LOCAL",
      "transport": "NATIVE",
      "model": "LUNA",
      "effort": "MEDIUM"
    }
  ],
  "task_launch": {
    "line_template": "TASK LAUNCH \u2014 {continuation} \u00b7 {surface} \u00b7 {model} \u00b7 effort: {effort}",
    "continuations": [
      "NEW",
      "CONTINUE"
    ],
    "prompt_inputs": [
      "repository",
      "branch",
      "task_path",
      "task_revision",
      "base_head",
      "phase",
      "surface"
    ],
    "fixtures": {
      "CHATGPT_GITHUB": "TASK LAUNCH \u2014 NEW \u00b7 CHATGPT_GITHUB \u00b7 GPT-5.6 Sol \u00b7 effort: HIGH",
      "CHATGPT_LOCAL": "TASK LAUNCH \u2014 NEW \u00b7 CHATGPT_LOCAL \u00b7 GPT-5.6 Sol \u00b7 effort: HIGH",
      "CODEX_CLOUD": "TASK LAUNCH \u2014 NEW \u00b7 CODEX_CLOUD \u00b7 LUNA \u00b7 effort: MEDIUM",
      "CODEX_LOCAL": "TASK LAUNCH \u2014 NEW \u00b7 CODEX_LOCAL \u00b7 LUNA \u00b7 effort: MEDIUM"
    },
    "prompt_template": "Target: {repository}\nBranch: {branch}\nTask: {task_path}\nTask revision: {task_revision}\nExact base HEAD: {base_head}\nPhase: {phase}\nExecution surface: {surface}\nResolve the canonical task at the exact base and obey it exactly. Communicate with the operator in Vietnamese. Persist repository artifacts in English."
  },
  "authority_set_identity": {
    "source": "AGENT_FOUNDATION_COMMIT",
    "self_pin": false,
    "evolution_ref": "main",
    "activation_ref": "main",
    "rollback": "FORWARD_ACTIVATION_COMMIT"
  },
  "target_binding": {
    "source": "EXPLICIT_CURRENT_REQUEST_OR_EXACT_ACTIVE_BINDING",
    "fresh_github_resolution_required": true,
    "unresolved_action": "ASK_OPERATOR",
    "forbidden_inference_sources": [
      "STALE_CHAT_HISTORY",
      "MEMORY",
      "CWD",
      "LOCAL_DIRECTORY_NAME"
    ],
    "required_fields": [
      "repository",
      "branch",
      "task_path",
      "task_revision",
      "base_head",
      "phase"
    ]
  }
}
