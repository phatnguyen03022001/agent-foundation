    "topology": "MAIN_ONLY",
    "working_ref": "main",
    "stable_ref": "main",
    "local_policy": "MANAGED_MIRROR"
  },
  "bootstrap_default_topology": "DEV_MAIN",
  "capability_routes": [
    {
      "capability": "architect",
      "owner": "skills",
      "path": "skills/architect/SKILL.md"
    },
    {
      "capability": "executor",
      "owner": "skills",
      "path": "skills/executor/SKILL.md"
    },
    {
      "capability": "task_protocol",
      "owner": "skills",
